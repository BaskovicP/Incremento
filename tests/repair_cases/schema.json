{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Incremento repair evaluation case",
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9_-]{1,100}$"},
    "mode": {"enum": ["guard", "repair"]},
    "operation": {"type": "string", "maxLength": 80},
    "input": {},
    "expected": {"type": "object"},
    "base_ref": {"type": "string", "maxLength": 200}
  },
  "required": ["schema_version", "id", "mode", "operation", "input", "expected"],
  "additionalProperties": false
}
