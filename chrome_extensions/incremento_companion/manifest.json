{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extension_name__",
  "version": "0.2.0",
  "description": "__MSG_extension_description__",
  "permissions": [
    "storage",
    "offscreen",
    "clipboardWrite",
    "webNavigation",
    "scripting",
    "activeTab",
    "bookmarks",
    "contextMenus"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtu.be/*",
    "*://*.vimeo.com/*",
    "http://127.0.0.1:8765/*",
    "http://127.0.0.1:8766/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "copy-last-video-time": {
      "suggested_key": {
        "default": "Alt+Shift+V",
        "mac": "Alt+Shift+V"
      },
      "description": "__MSG_command_copy_video_time__"
    },
    "add-current-page-as-pdf": {
      "description": "__MSG_command_add_pdf__"
    },
    "add-current-page-as-video": {
      "description": "__MSG_command_add_video__"
    },
    "add-current-page-as-webpage": {
      "description": "__MSG_command_add_webpage__"
    },
    "add-selection-to-markdown": {
      "description": "__MSG_command_add_selection__"
    },
    "add-page-to-markdown": {
      "description": "__MSG_command_add_page_markdown__"
    },
    "browser-capture-selection": {
      "suggested_key": {
        "default": "Alt+X"
      },
      "description": "__MSG_command_capture_selection__"
    },
    "browser-capture-snapshot": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "__MSG_command_capture_snapshot__"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtu.be/*",
        "*://*.vimeo.com/*"
      ],
      "all_frames": true,
      "js": [
        "content-loader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/content.js",
        "dist/assets/*.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "action": {
    "default_title": "__MSG_extension_name__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
