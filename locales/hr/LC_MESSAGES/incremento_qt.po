msgid "onboarding_welcome_title"
msgstr "Dobro došli u Incremento"

msgid "onboarding_welcome_body"
msgstr "Incremento zadržava dugo čitanje, izdvajanje, ponavljanje i napredak unutar Ankija. Ovaj kratki vodič prati najsigurniji početni tijek rada."

msgid "onboarding_add_document_title"
msgstr "1. Dodajte prvi dokument"

msgid "onboarding_add_document_body"
msgstr "Započnite PDF, EPUB ili DjVu dokumentom. Incremento sprema dokumente u aktivni Anki profil i vraća položaj čitanja."

msgid "onboarding_add_document_action"
msgstr "Dodaj PDF / DjVu…"

msgid "onboarding_extract_title"
msgstr "2. Izdvojite jednu korisnu ideju"

msgid "onboarding_extract_body"
msgstr "Odaberite odlomak u čitaču i izaberite Izdvoji. Prije spremanja provjerite izvor, odredišno polje, oznake, prioritet i upozorenje o duplikatu."

msgid "onboarding_start_session_title"
msgstr "3. Pokrenite malu sesiju"

msgid "onboarding_start_session_body"
msgstr "Najprije koristite osnovni prikaz sesije. Odaberite mali broj kartica i omjer Tema/Stavka te Dokument/Ostalo; napredni prikaz zadržava puni raspoređivač."

msgid "onboarding_start_session_action"
msgstr "Otvori postavljanje sesije…"

msgid "onboarding_extension_privacy_title"
msgstr "4. Povežite preglednik samo ako je potrebno"

msgid "onboarding_extension_privacy_body"
msgstr "Prateće proširenje prema zadanim postavkama koristi privremeni pristup. Trajni automatski pristup stranicama nije obavezan i može se opozvati u skočnom prozoru."

msgid "onboarding_backup_title"
msgstr "5. Izradite sigurnosnu kopiju"

msgid "onboarding_backup_body"
msgstr "Izvezite potpunu sigurnosnu kopiju prije velikog uvoza ili promjene tijeka rada. Radni sadržaj ostaje odvojen unutar aktivnog Anki profila."

msgid "onboarding_backup_action"
