#. Incremento UI: deps pymupdf
msgid "backend_deps_pymupdf"
msgstr "PyMuPDF  (PDF rendering & text extraction)"

#. Incremento UI: deps pymupdf instructions
msgid "backend_deps_pymupdf_instructions"
msgstr "PyMuPDF can be installed automatically by Incremento.\n\nIf automatic installation fails, run this command in a terminal:\n\n    {executable} -m pip install \"{requirement}\"\n\nThen restart Anki."

#. Incremento UI: deps restart notice
msgid "backend_deps_restart_notice"
msgstr "PyMuPDF installed — restart Anki to use it."

#. Incremento UI: deps tesseract
msgid "backend_deps_tesseract"
msgstr "Tesseract OCR  (converts scanned pages to searchable text)"

#. Incremento UI: deps tesseract linux
msgid "backend_deps_tesseract_linux"
msgstr "Install Tesseract with your package manager:\n\n    Ubuntu / Debian:  sudo apt install tesseract-ocr\n    Fedora:           sudo dnf install tesseract\n    Arch:             sudo pacman -S tesseract\n    openSUSE:         sudo zypper install tesseract-ocr\n\nAfter installation, restart Anki."

#. Incremento UI: deps tesseract mac
msgid "backend_deps_tesseract_mac"
msgstr "Install Tesseract via Homebrew:\n\n    brew install tesseract\n\nDon't have Homebrew?  Visit https://brew.sh to install it first.\n\nAfter installation, restart Anki."

#. Incremento UI: deps tesseract windows
msgid "backend_deps_tesseract_windows"
msgstr "Download and run the Tesseract installer for Windows:\n\n    https://github.com/UB-Mannheim/tesseract/wiki\n\nDuring setup, choose 'Add Tesseract to PATH'.\nIf you skip that option, install to the default location:\n    C:\\Program Files\\Tesseract-OCR\\\n\nAfter installation, restart Anki."

